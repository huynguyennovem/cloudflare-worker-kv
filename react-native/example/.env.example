# Copy this file to .env.local (ignored by git) and set your Worker URL:
# the https://<worker>.<subdomain>.workers.dev URL that `npm run deploy` prints
# in ../../worker (also in the dashboard: Workers & Pages > your Worker >
# Settings > Domains & Routes). Base URL only, without /v1/config.
# With a local Worker (`npx wrangler dev` in ../../worker):
#   iOS simulator and web: http://localhost:8787
#   Android emulator:      http://10.0.2.2:8787
EXPO_PUBLIC_CF_CONFIG_ENDPOINT=https://<worker>.<subdomain>.workers.dev

# Only if the Worker sets CLIENT_KEY. It is not a secret: it ships in the app.
EXPO_PUBLIC_CF_CLIENT_KEY=
